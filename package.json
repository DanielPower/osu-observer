{
  "name": "observer",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "app",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter app run dev",
    "build": "pnpm --filter app run build",
    "preview": "pnpm --filter app run preview",
    "db:migrate": "pnpm --filter app run db:migrate",
    "db:generate": "pnpm --filter app run db:generate",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc -b",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "test": "vitest run",
    "check": "concurrently --group \"pnpm:lint\" \"pnpm:typecheck\" \"pnpm:format\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.16.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.1.1"
}
