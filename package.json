{
  "name": "observer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --names web,api --prefix-color auto \"npm run dev -w apps/web\" \"npm run dev -w apps/api\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc -b",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "test": "vitest run",
    "check": "concurrently --group \"npm:lint\" \"npm:typecheck\" \"npm:prettier\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "oxlint": "^1.62.0",
    "prettier": "^3.8.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "bezier-easing": "^3.0.0",
    "colorjs.io": "^0.6.1",
    "colorthief": "^3.3.1"
  }
}
