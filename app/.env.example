# Postgres connection string.
# In Docker, point at the bundled `db` service: postgres://observer:observer@db:5432/observer
DATABASE_URL=postgres://observer@localhost:5432/observer

# osu! OAuth application — used so end users can log in with their own osu!
# account. Create one at https://osu.ppy.sh/home/account/edit#oauth.
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# Must exactly match the Application Callback URL on your OAuth app.
#   Dev:    http://localhost:5173/api/auth/callback
#   Docker: http://localhost/api/auth/callback
AUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Long random string used to sign session JWTs and salt anonymous viewer IP
# hashes. Generate one with: `openssl rand -hex 32`.
COOKIE_SECRET=

# Where downloaded beatmaps, replays, and skins are stored.
#   Dev:    ./media (relative to apps/api when run via `npm run dev`)
#   Docker: /data/media (mounted volume — see docker-compose.yml)
SAVE_MEDIA_PATH=./media
PUBLIC_SERVE_MEDIA_PATH=http://localhost:3000/api/media

# Where to redirect the user after a successful OAuth login.
#   Dev:    http://localhost:5173
#   Docker: http://localhost
FRONTEND_URL=http://localhost:3000
