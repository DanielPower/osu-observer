# Postgres connection string.
# In Docker, point at the bundled `db` service: postgres://observer:observer@db:5432/observer
DATABASE_URL=postgres://observer@localhost:5432/observer

# osu! OAuth application — used so end users can log in with their own osu!
# account. Create one at https://osu.ppy.sh/home/account/edit#oauth.
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# Must exactly match the Application Callback URL on your OAuth app.
#   Dev:    http://localhost:3000/api/auth/callback
#   Docker: http://localhost/api/auth/callback
AUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Long random string used to sign session JWTs and salt anonymous viewer IP
# hashes. Generate one with: `openssl rand -hex 32`.
COOKIE_SECRET=

# S3-compatible storage for downloaded beatmaps, replays, and skins. The bucket
# must already exist. Enable path-style URLs for providers such as SeaweedFS.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=osu-observer
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional when using temporary credentials.
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=true

# Public base URL used by browsers to download media directly. The bucket must
# allow public reads and cross-origin GET requests from FRONTEND_URL.
#   SeaweedFS path style: http://localhost:8333/osu-observer
#   DigitalOcean CDN:     https://observer.<region>.cdn.digitaloceanspaces.com
MEDIA_BASE_URL=http://localhost:8333/osu-observer

# Where to redirect the user after a successful OAuth login.
#   Dev:    http://localhost:3000
#   Docker: http://localhost
FRONTEND_URL=http://localhost:3000
